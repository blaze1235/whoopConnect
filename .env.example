# Server
PORT=3000

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# WHOOP developer app (https://developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a redirect URI registered in your WHOOP app.
# For local testing with ngrok: https://your-ngrok-url/whoop/callback
WHOOP_REDIRECT_URI=http://localhost:3000/whoop/callback

# AI explanation provider.
# Option A (free, no key needed): leave OPENAI_API_KEY empty -> the bot uses its
#   built-in rule-based explainer in Russian/Uzbek. Works offline, costs nothing.
# Option B (free hosted models): set OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   with an OpenRouter key and a free model, e.g.
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Option C (OpenAI): just set OPENAI_API_KEY, default model gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL / Supabase connection string
# Supabase example: postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whoop_bot
# Set to true for hosted databases that require SSL (e.g. Supabase)
DATABASE_SSL=false

# Daily summary schedule (cron, in DEFAULT_TIMEZONE)
DAILY_SUMMARY_CRON=0 8 * * *
DEFAULT_TIMEZONE=Asia/Tashkent
